{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yinshaohua/GPTEasy/tests/fixtures/contracts/schema/contract-manifest.schema.json",
  "title": "GPTEasy external contract evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "observed_version",
    "evidence_level",
    "captured_at",
    "origin_type",
    "summary_digests",
    "assertions",
    "counts",
    "redactions",
    "runner_lifecycle",
    "account_lifecycle",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "observed_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\r\\n]+$"
    },
    "evidence_level": {
      "enum": [
        "native",
        "blocked",
        "partial",
        "synthetic"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin_type": {
      "enum": [
        "github-actions",
        "local-positive-control"
      ]
    },
    "summary_digests": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "provenance.schema.json#/$defs/sha256"
      }
    },
    "assertions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "counts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "redactions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "api_key",
          "authorization",
          "command_line",
          "database_content",
          "raw_app_server_response",
          "raw_config"
        ]
      }
    },
    "runner_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ephemeral",
        "dedicated_job"
      ],
      "properties": {
        "ephemeral": {
          "type": "boolean"
        },
        "dedicated_job": {
          "type": "boolean"
        }
      }
    },
    "account_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_for_job",
        "profile_created_for_job",
        "cleanup_attempted",
        "cleanup_succeeded",
        "baseline_restored"
      ],
      "properties": {
        "created_for_job": {
          "type": "boolean"
        },
        "profile_created_for_job": {
          "type": "boolean"
        },
        "cleanup_attempted": {
          "type": "boolean"
        },
        "cleanup_succeeded": {
          "type": "boolean"
        },
        "baseline_restored": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  }
}
