{
  "schema_version": 1,
  "phase": "01",
  "cli": {
    "script": "scripts/contracts/run-phase1-contracts.ps1",
    "required_parameters": [
      "Scope",
      "Target",
      "Mode"
    ],
    "parameters": {
      "Scope": [
        "RunnerSelfTest",
        "ProvenanceSelfTest",
        "ContractSelfTest",
        "PackagingSelfTest",
        "Freeze",
        "PhaseComplete"
      ],
      "Target": [
        "Local",
        "WindowsX64",
        "WindowsArm64",
        "MacIntel",
        "MacAppleSilicon",
        "Wsl2"
      ],
      "Mode": [
        "Strict",
        "AllowBlocked"
      ]
    }
  },
  "exit_codes": {
    "0": {
      "name": "completed",
      "meaning": "Requested mode completed. AllowBlocked resource absence also uses this code, but the outcome must be blocked and never strict eligible."
    },
    "2": {
      "name": "assertion_failed",
      "meaning": "Behavior or assertion failure."
    },
    "3": {
      "name": "strict_prerequisite_blocked",
      "meaning": "A Strict prerequisite is missing or blocked."
    },
    "4": {
      "name": "provenance_invalid",
      "meaning": "Provenance or attestation is not trustworthy."
    },
    "5": {
      "name": "security_boundary_failed",
      "meaning": "A security, canary, or lifecycle boundary failed."
    },
    "64": {
      "name": "usage_or_combination_error",
      "meaning": "A parameter is missing or unknown, or the combination is undeclared."
    }
  },
  "allow_blocked": {
    "scopes": [
      "ContractSelfTest",
      "PackagingSelfTest"
    ],
    "targets": [
      "WindowsX64",
      "WindowsArm64",
      "MacIntel",
      "MacAppleSilicon",
      "Wsl2"
    ],
    "outcome": "blocked",
    "exit_code": 0,
    "strict_gate_eligible": false
  },
  "combinations": [
    {
      "scope": "RunnerSelfTest",
      "target": "Local",
      "modes": [
        "Strict"
      ],
      "dispatch": "runner-self-test"
    },
    {
      "scope": "ProvenanceSelfTest",
      "target": "Local",
      "modes": [
        "Strict"
      ],
      "dispatch": "provenance-self-test"
    },
    {
      "scope": "ContractSelfTest",
      "target": "Local",
      "modes": [
        "Strict"
      ],
      "dispatch": "contract-self-test-local"
    },
    {
      "scope": "ContractSelfTest",
      "target": "WindowsX64",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "contract-self-test-windows-x64"
    },
    {
      "scope": "ContractSelfTest",
      "target": "WindowsArm64",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "contract-self-test-windows-arm64"
    },
    {
      "scope": "ContractSelfTest",
      "target": "MacIntel",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "contract-self-test-mac-intel"
    },
    {
      "scope": "ContractSelfTest",
      "target": "MacAppleSilicon",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "contract-self-test-mac-apple-silicon"
    },
    {
      "scope": "ContractSelfTest",
      "target": "Wsl2",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "contract-self-test-wsl2"
    },
    {
      "scope": "PackagingSelfTest",
      "target": "Local",
      "modes": [
        "Strict"
      ],
      "dispatch": "packaging-self-test-local"
    },
    {
      "scope": "PackagingSelfTest",
      "target": "WindowsX64",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "packaging-self-test-windows-x64"
    },
    {
      "scope": "PackagingSelfTest",
      "target": "WindowsArm64",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "packaging-self-test-windows-arm64"
    },
    {
      "scope": "PackagingSelfTest",
      "target": "MacIntel",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "packaging-self-test-mac-intel"
    },
    {
      "scope": "PackagingSelfTest",
      "target": "MacAppleSilicon",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "packaging-self-test-mac-apple-silicon"
    },
    {
      "scope": "PackagingSelfTest",
      "target": "Wsl2",
      "modes": [
        "Strict",
        "AllowBlocked"
      ],
      "dispatch": "packaging-self-test-wsl2"
    },
    {
      "scope": "Freeze",
      "target": "Local",
      "modes": [
        "Strict"
      ],
      "dispatch": "freeze-local"
    },
    {
      "scope": "PhaseComplete",
      "target": "Local",
      "modes": [
        "Strict"
      ],
      "dispatch": "phase-complete-local"
    }
  ],
  "dispatch": {
    "runner-self-test": {
      "kind": "internal",
      "description": "Validate the CLI matrix, combinations, and exit-code contract without downstream scripts."
    },
    "provenance-self-test": {
      "kind": "command",
      "commands": [
        {
          "path": "scripts/contracts/validate-contract-evidence.ps1",
          "arguments": [
            "-SelfTest"
          ]
        },
        {
          "path": "scripts/contracts/test-evidence-provenance.ps1",
          "arguments": []
        }
      ]
    },
    "contract-self-test-local": {
      "kind": "aggregate",
      "required_paths": [
        "scripts/contracts/validate-contract-evidence.ps1"
      ]
    },
    "contract-self-test-windows-x64": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/codex/windows-x64/manifest.json",
        "tests/fixtures/contracts/host/windows-x64/manifest.json",
        "tests/fixtures/contracts/wsl2/windows-x64/manifest.json"
      ]
    },
    "contract-self-test-windows-arm64": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/codex/windows-arm64/manifest.json",
        "tests/fixtures/contracts/host/windows-arm64/manifest.json",
        "tests/fixtures/contracts/wsl2/windows-arm64/manifest.json"
      ]
    },
    "contract-self-test-mac-intel": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/codex/macos-intel/manifest.json",
        "tests/fixtures/contracts/host/macos-intel/manifest.json"
      ]
    },
    "contract-self-test-mac-apple-silicon": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/codex/macos-apple-silicon/manifest.json",
        "tests/fixtures/contracts/host/macos-apple-silicon/manifest.json"
      ]
    },
    "contract-self-test-wsl2": {
      "kind": "command",
      "commands": [
        {
          "path": "scripts/contracts/test-wsl2-probe.ps1",
          "arguments": []
        }
      ]
    },
    "packaging-self-test-local": {
      "kind": "command",
      "commands": [
        {
          "path": "scripts/contracts/test-windows-package-verifier.ps1",
          "arguments": [
            "-CaseSet",
            "All"
          ]
        },
        {
          "path": "scripts/contracts/test-macos-wave0-contract.ps1",
          "arguments": [
            "-Scripts",
            "scripts/contracts/probe-codex-macos.zsh,scripts/contracts/probe-macos-host.zsh,scripts/contracts/test-macos-contract-probes.zsh,scripts/contracts/assert-macos-job-lifecycle.zsh,scripts/contracts/run-macos.zsh,scripts/contracts/test-macos-package-verifier.zsh",
            "-Workflow",
            ".github/workflows/phase1-macos-wave0.yml",
            "-EvidenceWorkflow",
            ".github/workflows/phase1-macos-evidence.yml"
          ]
        }
      ]
    },
    "packaging-self-test-windows-x64": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/packaging/windows-x64/manifest.json"
      ]
    },
    "packaging-self-test-windows-arm64": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/packaging/windows-arm64/manifest.json"
      ]
    },
    "packaging-self-test-mac-intel": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/packaging/macos-intel/manifest.json"
      ]
    },
    "packaging-self-test-mac-apple-silicon": {
      "kind": "evidence_set",
      "validator_path": "scripts/contracts/validate-contract-evidence.ps1",
      "provenance_validator_path": "scripts/contracts/verify-evidence-provenance.ps1",
      "required_paths": [
        "tests/fixtures/contracts/packaging/macos-apple-silicon/manifest.json"
      ]
    },
    "packaging-self-test-wsl2": {
      "kind": "aggregate",
      "required_paths": [
        "scripts/contracts/test-wsl2-probe.ps1"
      ]
    },
    "path-smoke-self-test-local": {
      "kind": "process",
      "executable": "cargo",
      "arguments": [
        "test",
        "--manifest-path",
        "src-tauri/Cargo.toml",
        "--test",
        "path_smoke",
        "--locked"
      ],
      "required_paths": [
        "src-tauri/Cargo.toml",
        "src-tauri/tests/path_smoke.rs"
      ]
    },
    "windows-contract-self-test-local": {
      "kind": "command",
      "commands": [
        {
          "path": "scripts/contracts/test-windows-contract-probes.ps1",
          "arguments": []
        }
      ]
    },
    "freeze-local": {
      "kind": "composite",
      "required_dispatches": [
        "runner-self-test",
        "provenance-self-test",
        "path-smoke-self-test-local",
        "windows-contract-self-test-local",
        "contract-self-test-wsl2",
        "packaging-self-test-local"
      ],
      "freeze_kind": "non_signing_contract",
      "release_ready": false,
      "deferred_evidence": [
        "windows-x64-authenticode",
        "windows-arm64-authenticode",
        "macos-intel-developer-id-notarization",
        "macos-apple-silicon-developer-id-notarization"
      ]
    },
    "frontend-build-phase-complete": {
      "kind": "process",
      "executable": "npm",
      "arguments": [
        "run",
        "build"
      ],
      "required_paths": [
        "package.json",
        "package-lock.json"
      ]
    },
    "local-state-phase-complete": {
      "kind": "process",
      "executable": "cargo",
      "arguments": [
        "test",
        "--manifest-path",
        "src-tauri/Cargo.toml",
        "--all-targets",
        "--locked"
      ],
      "required_paths": [
        "src-tauri/tests/state_command_restart.rs",
        "src-tauri/tests/state_persistence.rs",
        "src-tauri/tests/local_only_boundary.rs",
        "src-tauri/tests/installed_state_smoke.rs",
        "src-tauri/tests/state_concurrency.rs",
        "src-tauri/tests/migration_matrix.rs",
        "src-tauri/tests/db_contract_validation.rs",
        "src-tauri/tests/ready_preflight.rs",
        "src-tauri/tests/migration_failure.rs",
        "src-tauri/tests/backup_restore.rs",
        "src-tauri/tests/higher_schema_refusal.rs",
        "src-tauri/tests/recovery_validation.rs",
        "src-tauri/tests/installed_recovery_smoke.rs"
      ]
    },
    "migration-policy-phase-complete": {
      "kind": "command",
      "commands": [
        {
          "path": "scripts/contracts/verify-migration-history.ps1",
          "arguments": []
        },
        {
          "path": "scripts/contracts/verify-migration-policy.ps1",
          "arguments": []
        }
      ]
    },
    "phase-complete-local": {
      "kind": "phase_complete",
      "formal_evidence_dispatches": [
        "contract-self-test-windows-x64",
        "contract-self-test-windows-arm64",
        "contract-self-test-mac-intel",
        "contract-self-test-mac-apple-silicon",
        "packaging-self-test-windows-x64",
        "packaging-self-test-windows-arm64",
        "packaging-self-test-mac-intel",
        "packaging-self-test-mac-apple-silicon"
      ],
      "required_dispatches": [
        "freeze-local",
        "frontend-build-phase-complete",
        "local-state-phase-complete",
        "migration-policy-phase-complete",
        "contract-self-test-windows-x64",
        "contract-self-test-windows-arm64",
        "contract-self-test-mac-intel",
        "contract-self-test-mac-apple-silicon",
        "packaging-self-test-windows-x64",
        "packaging-self-test-windows-arm64",
        "packaging-self-test-mac-intel",
        "packaging-self-test-mac-apple-silicon"
      ]
    }
  }
}
