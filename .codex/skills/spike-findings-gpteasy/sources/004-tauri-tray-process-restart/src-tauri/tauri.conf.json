{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPTEasy Spike 004",
  "version": "0.1.0",
  "identifier": "com.gpteasy.spike.process",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GPTEasy — 进程与重启 Spike",
        "width": 980,
        "height": 760,
        "minWidth": 680,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
