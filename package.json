{
  "name": "gpteasy",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode browser-preview",
    "check": "tsc --noEmit && eslint src tests/ui playwright.config.ts vite.config.ts vitest.config.ts eslint.config.js",
    "test": "vitest run && npm run test:gitcode-sync",
    "test:gitcode-sync": "node --test scripts/sync-gitcode-release.test.mjs",
    "pretest:layout": "npm run build:preview",
    "test:layout": "playwright test -c playwright.config.ts",
    "prepreview:browser": "npm run build:preview",
    "preview:browser": "vite preview --host 127.0.0.1 --port 1422",
    "acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-acceptance-gate.ps1",
    "acceptance:linux-wsl": "pwsh -NoProfile -File scripts/run-linux-wsl-acceptance-gate.ps1 -Mode Full",
    "acceptance:linux-wsl:automated": "pwsh -NoProfile -File scripts/run-linux-wsl-acceptance-gate.ps1 -Mode Automated",
    "acceptance:all": "pwsh -NoProfile -File scripts/run-all-acceptance-gates.ps1",
    "candidate:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-candidate.ps1",
    "uat:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-uat.ps1",
    "release:tree": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-release-tree.ps1",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-release-readiness.ps1",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release.ps1",
    "release:manifest": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-updater-manifest.ps1",
    "release:trust-root": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-update-trust-root.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
