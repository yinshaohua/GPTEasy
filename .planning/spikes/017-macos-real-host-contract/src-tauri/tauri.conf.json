{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPTEasy Spike 017",
  "version": "0.1.0",
  "identifier": "com.gpteasy.spike.macos-contract",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GPTEasy — macOS 真实宿主契约",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
